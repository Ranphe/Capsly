<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresarAbierta"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Regresar"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="‹"
            android:textColor="#252F27"
            android:textSize="32sp"
            app:backgroundTint="@android:color/transparent" />

        <ImageView
            android:id="@+id/imgCapsulaAbierta"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/screenpill_y" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/playfair_display_extrabold"
            android:gravity="center"
            android:text="¡Es momento de abrir tu cápsula!"
            android:textColor="#252F27"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvMensajeCapsulaAbierta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Ya puedes ver el recuerdo que guardaste."
            android:textColor="#46534A"
            android:textSize="15sp"
            tools:text="Este recuerdo fue creado el 27 de septiembre de 2026." />

        <Space
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerCapsulaAbierta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="0dp"
            android:fontFamily="@font/lora_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="54dp"
            android:stateListAnimator="@null"
            android:text="Abrir cápsula"
            android:textAllCaps="false"
            android:textColor="#252F27"
            android:textSize="16sp"
            app:backgroundTint="#F9E77E"
            app:cornerRadius="27dp" />

    </LinearLayout>

</ScrollView>