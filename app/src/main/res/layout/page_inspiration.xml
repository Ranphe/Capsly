<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/inspirationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverCrearRecuerdo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Volver a crear recuerdo"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textColor="#252F27"
                android:textSize="30sp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="24dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/playfair_display_extrabold"
                android:gravity="center"
                android:text="Inspiración"
                android:textColor="#252F27"
                android:textSize="25sp" />

            <Space
                android:layout_width="48dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <!-- Frase obtenida mediante Volley -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#FFFCF7"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#7F9990"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvFraseInspiracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:gravity="center"
                android:padding="20dp"
                android:fontFamily="@font/lora_bold"
                android:text="Presiona Nueva para obtener una frase."
                android:textColor="#252F27"
                android:textSize="19sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Botones Nueva y Guardar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevaFrase"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/lora_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:text="Nueva"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="#34665A"
                app:cornerRadius="25dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarFrase"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/lora_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:enabled="false"
                android:text="Guardar"
                android:textAllCaps="false"
                android:textColor="#34665A"
                android:textSize="15sp"
                app:backgroundTint="#E7F1EC"
                app:cornerRadius="25dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- Indicador de carga para Volley -->
        <ProgressBar
            android:id="@+id/progresoFrase"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="#34665A"
            android:visibility="gone" />

        <!-- Título de frases guardadas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/playfair_display_extrabold"
            android:gravity="center"
            android:text="Guardadas"
            android:textColor="#252F27"
            android:textSize="24sp" />

        <!-- Tabla de frases almacenadas en SQLite -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFCF7"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#CCD9D0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvSinFrases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Aún no tienes frases guardadas."
                    android:textColor="#65736D"
                    android:textSize="14sp" />

                <TableLayout
                    android:id="@+id/tablaFrasesGuardadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0"
                    android:shrinkColumns="0" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
