<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/capsulaListaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresarCapsulaLista"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:contentDescription="Regresar"
            android:elevation="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="‹"
            android:textColor="#252F27"
            android:textSize="32sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp" />

        <ImageView
            android:id="@+id/imgCapsulaLista"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/screenpill1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/playfair_display_extrabold"
            android:gravity="center"
            android:text="¡Cápsula lista!"
            android:textColor="#252F27"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvMensajeCapsulaLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Tu recuerdo ha sido guardado y permanecerá protegido hasta la fecha de apertura."
            android:textColor="#46534A"
            android:textSize="16sp"
            tools:text="Tu recuerdo ha sido guardado y permanecerá protegido hasta el 27 de septiembre de 2043." />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#FFFCF7"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#7F9990"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    app:srcCompat="@android:drawable/ic_lock_lock"
                    app:tint="#34665A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Solo tú podrás modificar tu recuerdo antes de la fecha de apertura."
                    android:textColor="#252F27"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerEnBoveda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            android:fontFamily="@font/lora_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="54dp"
            android:stateListAnimator="@null"
            android:text="Ver en Bóveda"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#34665A"
            app:cornerRadius="27dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresarInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:elevation="0dp"
            android:fontFamily="@font/lora_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="54dp"
            android:stateListAnimator="@null"
            android:text="Regresar a Inicio"
            android:textAllCaps="false"
            android:textColor="#34665A"
            android:textSize="16sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="27dp"
            app:strokeColor="#7F9990"
            app:strokeWidth="1dp" />

    </LinearLayout>

</ScrollView>