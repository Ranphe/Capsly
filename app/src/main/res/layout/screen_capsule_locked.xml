<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresarBloqueada"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Regresar"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="‹"
            android:textColor="#252F27"
            android:textSize="32sp"
            app:backgroundTint="@android:color/transparent" />

        <ImageView
            android:id="@+id/imgCapsulaBloqueada"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/screenpill_p" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/playfair_display_extrabold"
            android:gravity="center"
            android:text="Cápsula bloqueada"
            android:textColor="#252F27"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvFechaBloqueada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Este recuerdo se abrirá en la fecha que elegiste."
            android:textColor="#46534A"
            android:textSize="15sp"
            tools:text="Este recuerdo se abrirá el 27 de septiembre de 2043." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#FFFCF7"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvDiasBloqueada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora_bold"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:padding="6dp"
                    android:text="—\ndías"
                    android:textColor="#252F27"
                    android:textSize="16sp"
                    tools:text="498\ndías" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#FFFCF7"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvHorasBloqueada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora_bold"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:padding="6dp"
                    android:text="—\nhoras"
                    android:textColor="#252F27"
                    android:textSize="16sp"
                    tools:text="8\nhoras" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#FFFCF7"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvMinutosBloqueada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora_bold"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:padding="6dp"
                    android:text="—\nminutos"
                    android:textColor="#252F27"
                    android:textSize="16sp"
                    tools:text="14\nminutos" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFCF7"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#7F9990"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@android:drawable/ic_lock_lock"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:text="Este recuerdo estará disponible cuando llegue su fecha de apertura."
                android:textColor="#46534A"
                android:textSize="14sp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>