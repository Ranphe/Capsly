<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recuerdoAbiertoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresarRecuerdo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Regresar"
            android:elevation="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="‹"
            android:textColor="#252F27"
            android:textSize="32sp"
            app:backgroundTint="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/contenidoCentradoRecuerdo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgRecuerdoAbierto"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="12dp"
                android:contentDescription="Imagen del recuerdo"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <VideoView
                android:id="@+id/videoRecuerdoAbierto"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTituloRecuerdoAbierto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/playfair_display_extrabold"
                android:gravity="center"
                android:textColor="#252F27"
                android:textSize="26sp"
                tools:text="Nuestro viaje familiar" />

            <TextView
                android:id="@+id/tvFechaRecuerdoAbierto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#46534A"
                android:textSize="15sp"
                tools:text="10 de junio de 2026" />

            <LinearLayout
                android:id="@+id/contenedorVideoRecuerdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/barraVideoRecuerdo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Posición del video" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTiempoActualVideo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="00:00"
                        android:textColor="#46534A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDuracionVideo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="00:00"
                        android:textColor="#46534A"
                        android:textSize="13sp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnReproducirVideo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_media_play"
                    android:contentDescription="Reproducir video"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@android:drawable/ic_media_play"
                    app:tint="#FFFFFF" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorAudioRecuerdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/barraAudioRecuerdo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Posición del audio" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTiempoActualAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="00:00"
                        android:textColor="#46534A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDuracionAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="00:00"
                        android:textColor="#46534A"
                        android:textSize="13sp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnReproducirAudio"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_media_play"
                    android:contentDescription="Reproducir audio"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@android:drawable/ic_media_play"
                    app:tint="#FFFFFF" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirDocumento"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:elevation="0dp"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="Abrir documento"
                android:textAllCaps="false"
                android:textColor="#34665A"
                android:textSize="16sp"
                android:visibility="gone"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="16dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTextoRecuerdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFCF7"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvTextoRecuerdoAbierto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:textColor="#252F27"
                    android:textSize="16sp"
                    tools:text="Recuerda siempre lo increíble que fue este momento…" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>