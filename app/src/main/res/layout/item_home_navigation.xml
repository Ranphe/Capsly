<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pagerPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/barraNavegacionInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B9DED2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="Inicio"
            android:textAllCaps="false"
            android:textColor="#252F27"
            android:textSize="12sp"
            app:backgroundTint="@color/nav_fondo_pestana"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_home"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="24dp"
            app:iconTint="#252F27" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navCrear"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="Crear cápsula"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                app:backgroundTint="#34665A"
                app:cornerRadius="28dp" />

        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navBoveda"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="Bóveda"
            android:textAllCaps="false"
            android:textColor="#252F27"
            android:textSize="12sp"
            app:backgroundTint="@color/nav_fondo_pestana"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_vault"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="24dp"
            app:iconTint="#252F27" />

    </LinearLayout>

</LinearLayout>