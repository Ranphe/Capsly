<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/perfilRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_extrabold"
            android:text="Perfil"
            android:textColor="#252F27"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tu espacio en la cápsula familiar."
            android:textColor="#46534A"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="124dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#E7F1EC"
                app:cardCornerRadius="54dp"
                app:cardElevation="0dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto de perfil"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/screenpfp" />

            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/btnEditarNombrePerfil"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_edit_nickname"
                android:contentDescription="Editar nickname"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#252F27" />

        </FrameLayout>

        <EditText
            android:id="@+id/etNombrePerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent"
            android:cursorVisible="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:fontFamily="@font/playfair_display_extrabold"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:inputType="textCapWords|textNoSuggestions"
            android:maxLength="20"
            android:singleLine="true"
            android:text="Usuario"
            android:textColor="#252F27"
            android:textSize="26sp"
            tools:text="SofiaGarcia" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/lora_bold"
            android:text="Información de la cuenta"
            android:textColor="#252F27"
            android:textSize="19sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFFCF7"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#CCD9D0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora_bold"
                    android:text="Correo electrónico"
                    android:textColor="#252F27"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCorreoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="—"
                    android:textColor="#46534A"
                    android:textSize="16sp"
                    tools:text="sofia@example.com" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#CCD9D0"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora_bold"
                    android:text="Contraseña"
                    android:textColor="#252F27"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Contraseña oculta"
                    android:letterSpacing="0.12"
                    android:text="••••••••"
                    android:textColor="#46534A"
                    android:textSize="18sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/lora_bold"
            android:text="Ayuda"
            android:textColor="#252F27"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tvAyudaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="Para crear una cápsula, toca el botón + y elige una fecha de apertura.\n\nEn Mi Bóveda encontrarás todas tus cápsulas. Usa los filtros para consultar las bloqueadas o las que ya abriste.\n\nEn Inicio puedes ver las tres aperturas más cercanas."
            android:textColor="#46534A"
            android:textSize="16sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            android:fontFamily="@font/lora_bold"
            android:minHeight="54dp"
            android:stateListAnimator="@null"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="#34665A"
            android:textSize="16sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="16dp"
            app:strokeColor="#7F9990"
            app:strokeWidth="1dp" />

    </LinearLayout>

</ScrollView>