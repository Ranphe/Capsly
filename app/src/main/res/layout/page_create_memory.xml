<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/crearRecuerdoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverInicio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Volver a Inicio"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textColor="#252F27"
                android:textSize="30sp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="24dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/playfair_display_extrabold"
                android:gravity="center"
                android:text="Crear recuerdo"
                android:textColor="#252F27"
                android:textSize="25sp" />

            <Space
                android:layout_width="48dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Título"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="#5D877E">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTituloRecuerdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="#252F27" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/lora_bold"
            android:text="Formato"
            android:textColor="#252F27"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormatoFoto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:stateListAnimator="@null"
                android:text="Foto"
                android:textAllCaps="false"
                android:textColor="#252F27"
                android:textSize="14sp"
                app:backgroundTint="#E7DFF3"
                app:cornerRadius="22dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormatoVideo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:stateListAnimator="@null"
                android:text="Video"
                android:textAllCaps="false"
                android:textColor="#252F27"
                android:textSize="14sp"
                app:backgroundTint="#E0EBCB"
                app:cornerRadius="22dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormatoAudio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:stateListAnimator="@null"
                android:text="Audio"
                android:textAllCaps="false"
                android:textColor="#252F27"
                android:textSize="14sp"
                app:backgroundTint="#F9E77E"
                app:cornerRadius="22dp"
                app:strokeColor="#7F9990"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvAyudaFormato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Selecciona un formato para agregar tu recuerdo"
            android:textColor="#65736D"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panelSeleccionArchivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFCF7"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#CCD9D0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTituloArchivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora_bold"
                    android:text="Agregar archivo"
                    android:textColor="#252F27"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeleccionarArchivo"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:elevation="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:stateListAnimator="@null"
                        android:text="Galería"
                        android:textAllCaps="false"
                        android:textColor="#34665A"
                        android:textSize="13sp"
                        app:backgroundTint="#FFFCF7"
                        app:cornerRadius="16dp"
                        app:icon="@android:drawable/ic_menu_gallery"
                        app:iconPadding="4dp"
                        app:iconSize="18dp"
                        app:iconTint="#34665A"
                        app:strokeColor="#7F9990"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCapturarArchivo"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:elevation="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:stateListAnimator="@null"
                        android:text="Cámara"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        app:backgroundTint="#5D877E"
                        app:cornerRadius="16dp"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconPadding="4dp"
                        app:iconSize="18dp"
                        app:iconTint="#FFFFFF" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvEstadoArchivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Ningún archivo seleccionado"
                    android:textColor="#65736D"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/imgVistaPreviaRecuerdo"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="Vista previa de la fotografía"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/contenedorVideoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:clipChildren="true"
                            android:clipToPadding="true">

                            <VideoView
                                android:id="@+id/videoVistaPreviaRecuerdo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center" />

                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/controlesVideoOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btnPlayPausaVideo"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@android:color/transparent"
                                    android:contentDescription="Reproducir o pausar video"
                                    android:padding="4dp"
                                    android:src="@android:drawable/ic_media_play"
                                    app:tint="?attr/colorControlActivated" />

                                <SeekBar
                                    android:id="@+id/seekBarVideo"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:max="1000"
                                    android:progress="0"
                                    android:splitTrack="false" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="44dp"
                                android:layout_marginTop="2dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvTiempoActualVideo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="00:00"
                                    android:textColor="#65736D"
                                    android:textSize="12sp" />

                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/tvDuracionVideo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="00:00"
                                    android:textColor="#65736D"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/controlesAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnPlayPausaAudio"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Reproducir o pausar audio"
                            android:padding="4dp"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="?attr/colorControlActivated" />

                        <SeekBar
                            android:id="@+id/seekBarAudio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:max="1000"
                            android:progress="0"
                            android:splitTrack="false" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="44dp"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTiempoActualAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#65736D"
                            android:textSize="12sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvDuracionAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#65736D"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Contenido"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="#5D877E">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContenidoRecuerdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:textColor="#252F27" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Escribe un mensaje para acompañar tu recuerdo."
            android:textColor="#65736D"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Correo del destinatario"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="#5D877E">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDestinatarioRecuerdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="#252F27" />

        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInspiracion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/lora_bold"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Inspiración"
            android:textAllCaps="false"
            android:textColor="#34665A"
            android:textSize="14sp"
            app:backgroundTint="#E7F1EC"
            app:cornerRadius="22dp"
            app:strokeColor="#7F9990"
            app:strokeWidth="1dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/lora_bold"
            android:text="Fecha de apertura"
            android:textColor="#252F27"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFechaApertura"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:elevation="0dp"
            android:freezesText="true"
            android:gravity="start|center_vertical"
            android:minHeight="52dp"
            android:stateListAnimator="@null"
            android:text="Elegir fecha"
            android:textAllCaps="false"
            android:textColor="#34665A"
            android:textSize="15sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="18dp"
            app:icon="@android:drawable/ic_menu_my_calendar"
            app:iconGravity="end"
            app:iconSize="20dp"
            app:iconTint="#34665A"
            app:strokeColor="#7F9990"
            app:strokeWidth="1dp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuarRecuerdo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:elevation="0dp"
            android:fontFamily="@font/lora_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#34665A"
            app:cornerRadius="27dp" />

    </LinearLayout>

</ScrollView>