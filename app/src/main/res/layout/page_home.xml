<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inicioRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8F1"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/playfair_display_extrabold"
            android:text="¡Bienvenido!"
            android:textColor="#252F27"
            android:textSize="30sp"
            tools:text="¡Hola, usuario!" />

        <ImageButton
            android:id="@+id/btnFotoPerfil"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir perfil"
            android:padding="8dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/screenpfp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="16dp">

        <View
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/fondo_halo_pill"
            android:importantForAccessibility="no"
            android:scaleX="1.90" />

        <ImageView
            android:id="@+id/imgCapsulaInicio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/screenpill2" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvCantidadCapsulas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Tienes 0 cápsulas"
        android:textColor="#46534A"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrearCapsula"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/lora_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="+ Crear cápsula"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:backgroundTint="#609083"
        app:cornerRadius="26dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="16dp"
        android:background="#CCD9D0"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/seccionProximasAperturas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lora_bold"
            android:text="Próximas aperturas"
            android:textColor="#252F27"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnVerTodasAperturas"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Ver todas ›"
            android:textColor="#34665A"
            android:textSize="14sp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollProximasAperturas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSinCapsulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFCF7"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#CCD9D0"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Aún no hay próximas aperturas."
                    android:textColor="#46534A"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/contenedorProximasCapsulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>