<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCapsulaBoveda"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFCF7"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#7F9990"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="112dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgPastillaBoveda"
            android:layout_width="40dp"
            android:layout_height="64dp"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/screenpill_n" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreCapsula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lora_bold"
                android:textColor="#252F27"
                android:textSize="16sp"
                tools:text="Cumpleaños de Sofía" />

            <TextView
                android:id="@+id/tvFechaCapsula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#46534A"
                android:textSize="14sp"
                tools:text="27 sep 2043" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDiasCapsula"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#46534A"
                    android:textSize="13sp"
                    tools:text="27 días" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fondoEstadoCapsula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#D1EBF6"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvEstadoCapsula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="80dp"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="#252F27"
                        android:textSize="13sp"
                        tools:text="Próxima" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:text="›"
            android:textColor="#46534A"
            android:textSize="24sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>